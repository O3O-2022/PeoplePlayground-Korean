<Project Sdk="Microsoft.NET.Sdk">
  <!-- 게임에 BepInEx가 설치되어 있으면 그 안의 Mono.Cecil을 쓴다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\People Playground</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
